rules_version = '2';
// Reglas de Cloud Firestore · Mantenimiento Línea Italia
// - Solo entra quien tiene cuenta (nómina + contraseña) Y está dado de alta y activo en el personal de esa aplicación.
// - La configuración (personal, máquinas, pantallas, apariencia) solo la cambian administradores.
// - Mientras no exista la lista de personal (primera carga), se permite crearla.
service cloud.firestore {
  match /databases/{database}/documents {
    function nomina() {
      return request.auth.token.email.split('@')[0];
    }
    function rutaPersonal(app) {
      return /databases/$(database)/documents/apps/$(app)/config/personal;
    }
    function hayPersonal(app) {
      return exists(rutaPersonal(app));
    }
    function persona(app) {
      return get(rutaPersonal(app)).data.p[nomina()];
    }
    function enPersonal(app) {
      return request.auth != null && hayPersonal(app)
        && nomina() in get(rutaPersonal(app)).data.p
        && persona(app).get('a', true) != false;
    }
    function esAdmin(app) {
      return enPersonal(app) && persona(app).r in ['admin', 'general'];
    }
    match /apps/{app}/{col}/{rest=**} {
      allow read: if enPersonal(app);
      allow write: if (enPersonal(app) && (col != 'config' || esAdmin(app)))
                   || (request.auth != null && !hayPersonal(app));
    }
  }
}
